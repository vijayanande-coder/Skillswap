# SkillSwap Environment Variables

PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# For local MongoDB: mongodb://127.0.0.1:27017/skillswap
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/skillswap?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/skillswap

# JWT Secret for authentication
JWT_SECRET=skillswap_dev_jwt_secret_key_2026_super_secure
